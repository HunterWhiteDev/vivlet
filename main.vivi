// vivlet 1.1.7 - a "smol itty bitty" pretty well featured text editor written in Vivi and file trees too :chad:
// created by Xansidev - github:XansiOnGit
// i was just adding features until i didn't want to anymore
// 1.1.7: Native syscalls, no more bash subprocesses for IO, thank jesus.
// and a vim mode for you F r e a k s

#import "Io"
#import "Strings"
#import "Time"
#import "Sys" as sys

// this is just for people like flawda honestly.
// Vim state
vim_mode := false
vim_insert := true
vim_pending_count := ""
vim_operator := ""
vim_register := ""
vim_visual := false
frame_count := 0
lines := [""]
cx := 0
cy := 0
scroll_x := 0
scroll_y := 0
current_file := ""
modified := false

status_msg := ""
dirty := true
running := true

TERM_W := 80
TERM_H := 24
VIEW_W := 60
VIEW_H := 20
TW := 28
ED_X := 1

// input state
buf := ""
seq_final := 0
seq_params := ""
in_paste := false
paste_cr := false
lossy_flag := false

// tabs
tab_lines := []
tab_cx := []
tab_cy := []
tab_sx := []
tab_sy := []
tab_paths := []
tab_mod := []
cur_tab := 0
tab_first := 0

hit_tab := []
hit_x0 := []
hit_x1 := []

// file tree
tree_path := []
tree_name := []
tree_depth := []
tree_isdir := []
tree_expanded := []
tree_root := ""
tree_open := false
tree_focus := false
tree_sel := 0
tree_scroll := 0

// small helpers

clamp_cx := () {
    if cx > lines[cy].len cx = lines[cy].len
}

repeat_str := (s, count) {
    if count <= 0 return ""
    out := ""
    cur := s
    n := count
    while n > 0 {
        if n % 2 == 1 { out ~= cur }
        n /= 2
        if n > 0 { cur ~= cur }
    }
    return out
}

new_rows := () { return [""] }

base_name := (p) {
    start := 0
    for i := 0; i < _len(p); i++ {
        if p.char_at(i) == "/" { start = i + 1 }
    }
    return substring(p, start, _len(p))
}

join_path := (a, b) {
    if has_suffix(a, "/") return a ~ b
    return a ~ "/" ~ b
}

matching_close := (code) {
    if code == 91 return 93
    if code == 60 return 62
    if code == 34 return 34
    if code == 39 return 39
    if code == 123 return 125
    if code == 40 return 41
    return 0
}

is_closing_char := (code) {
    return code == 93 or code == 62 or code == 34 or code == 39 or code == 125 or code == 41
}

layout := () {
    TW = 28
    if TERM_W < 80 TW = TERM_W / 3
    ED_X = 1
    if tree_open ED_X = TW + 2
    VIEW_W = TERM_W - ED_X
    VIEW_H = TERM_H - 2
    if VIEW_W < 10 VIEW_W = 10
    if VIEW_H < 3 VIEW_H = 3
}

draw_box := (top, left, w, title, rows_in) {
    cursor_hide()
    cursor_to(top, left)
    print("╭─ " ~ title ~ " " ~ repeat_str("─", w - _len(title) - 3) ~ "╮")
    for q := 0; q < rows_in.len; q++ {
        txt := rows_in[q]
        if _len(txt) > w - 2 txt = substring(txt, 0, w - 2)
        cursor_to(top + 1 + q, left)
        print("│ " ~ txt ~ repeat_str(" ", w - 1 - _len(txt)) ~ "│")
    }
    cursor_to(top + 1 + rows_in.len, left)
    print("╰" ~ repeat_str("─", w) ~ "╯")
}

confirm := (msg) {
    w := 46
    if w > TERM_W - 2 w = TERM_W - 2
    top := (TERM_H / 2) - 2
    if top < 2 top = 2
    left := ((TERM_W - w - 2) / 2) + 1
    if left < 1 left = 1
    while true {
        draw_box(top, left, w, "Confirm", [msg, "", "y: yes     n / Esc: no"])
        raw := _read(0, 64)
        if raw == null or _len(raw) == 0 continue
        code := i32(rune(raw.char_at(0)))
        if code == 121 or code == 89 return true
        if code == 110 or code == 78 return false
        if code == 27 and _len(raw) == 1 return false
    }
}

// tabs

save_tab := () {
    tab_lines[cur_tab] = lines
    tab_cx[cur_tab] = cx
    tab_cy[cur_tab] = cy
    tab_sx[cur_tab] = scroll_x
    tab_sy[cur_tab] = scroll_y
    tab_paths[cur_tab] = current_file
    tab_mod[cur_tab] = modified
}

load_tab := (n) {
    cur_tab = n
    lines = tab_lines[n]
    cx = tab_cx[n]
    cy = tab_cy[n]
    scroll_x = tab_sx[n]
    scroll_y = tab_sy[n]
    current_file = tab_paths[n]
    modified = tab_mod[n]
    dirty = true
}

switch_tab := (t) {
    if t == cur_tab return
    save_tab()
    load_tab(t)
}

next_tab := (d) {
    cnt := tab_paths.len
    if cnt > 1 {
        t := cur_tab + d
        if t < 0 t = cnt - 1
        if t >= cnt t = 0
        switch_tab(t)
    }
}

add_tab := (path, rows) {
    reuse := false
    if _len(path) > 0 and tab_paths.len == 1 and _len(current_file) == 0 and modified == false and lines.len == 1 and lines[0].len == 0 {
        reuse = true
    }
    if reuse == false {
        save_tab()
        tab_lines.push(rows)
        tab_cx.push(0)
        tab_cy.push(0)
        tab_sx.push(0)
        tab_sy.push(0)
        tab_paths.push(path)
        tab_mod.push(false)
        load_tab(tab_paths.len - 1)
    } else {
        tab_lines[0] = rows
        tab_cx[0] = 0
        tab_cy[0] = 0
        tab_sx[0] = 0
        tab_sy[0] = 0
        tab_paths[0] = path
        tab_mod[0] = false
        load_tab(0)
    }
}

close_tab := (t) {
    save_tab()
    if tab_mod[t] == true {
        if confirm("Discard unsaved changes in this tab?") == false {
            dirty = true
            return
        }
    }
    tab_lines.take(t)
    tab_cx.take(t)
    tab_cy.take(t)
    tab_sx.take(t)
    tab_sy.take(t)
    tab_paths.take(t)
    tab_mod.take(t)

    target := cur_tab
    if t < cur_tab { target = cur_tab - 1 } else if t == cur_tab { target = t }
    if tab_paths.len == 0 {
        tab_lines.push(new_rows())
        tab_cx.push(0)
        tab_cy.push(0)
        tab_sx.push(0)
        tab_sy.push(0)
        tab_paths.push("")
        tab_mod.push(false)
        target = 0
    }
    if target >= tab_paths.len target = tab_paths.len - 1
    load_tab(target)
    dirty = true
}

// file io

read_file_rows := (path) {
    lossy_flag = false
    res := file_lines(path)
    if res == null { return [""] }
    if res.len() == 0 { return [""] }
    if res[res.len() - 1] == "" { res.take(res.len() - 1) }
    if res.len() == 0 return [""]
    return res
}

open_path := (path) {
    for t := 0; t < tab_paths.len; t++ {
        found := tab_paths[t]
        if t == cur_tab found = current_file
        if found == path {
            switch_tab(t)
            status_msg = "Switched to: " ~ path
            return
        }
    }
    if file_exists(path) {
        add_tab(path, read_file_rows(path))
        status_msg = "Opened: " ~ path
    } else {
        add_tab(path, new_rows())
        status_msg = "New file: " ~ path
    }
}

// file tree (now using native sys.list_dir)

is_expanded := (p) {
    for x := 0; x < tree_expanded.len; x++ {
        if tree_expanded[x] == p return true
    }
    return false
}

tree_add := (dir, depth) {
    if tree_name.len > 3000 return
    entries := sys.list_dir(dir) // Native sys.list_dir
    if entries == null return

    dirs := []
    files := []
    for q := 0; q < entries.len; q++ {
        en := entries[q]
        full := join_path(dir, en)
        if sys.is_dir(full) {
            dirs.push(en)
        } else {
            files.push(en)
        }
    }
    for q := 0; q < dirs.len; q++ {
        full := join_path(dir, dirs[q])
        tree_path.push(full)
        tree_name.push(dirs[q])
        tree_depth.push(depth)
        tree_isdir.push(true)
        if is_expanded(full) {
            tree_add(full, depth + 1)
        }
    }
    for q := 0; q < files.len; q++ {
        tree_path.push(join_path(dir, files[q]))
        tree_name.push(files[q])
        tree_depth.push(depth)
        tree_isdir.push(false)
    }
}

tree_rebuild := () {
    tree_path = []
    tree_name = []
    tree_depth = []
    tree_isdir = []
    if _len(tree_root) > 0 {
        tree_add(tree_root, 0)
    }
    if tree_sel > tree_name.len - 1 tree_sel = tree_name.len - 1
    if tree_sel < 0 tree_sel = 0
}

save_to_disk := (path) {
    out := ""
    for r := 0; r < lines.len(); r++ {
        out ~= lines[r]
        if r < lines.len() - 1 out ~= "\n"
    }
    file_write(path, out)
    current_file = path
    modified = false
    status_msg = "Saved: " ~ path
    if tree_open { tree_rebuild() }
}

tree_move := (d) {
    tree_sel += d
    if tree_sel < 0 tree_sel = 0
    if tree_sel > tree_name.len - 1 tree_sel = tree_name.len - 1
    vis := VIEW_H - 1
    if tree_sel < tree_scroll tree_scroll = tree_sel
    if tree_sel >= tree_scroll + vis tree_scroll = tree_sel - vis + 1
}

tree_activate := (k) {
    if k < 0 or k >= tree_name.len return
    if tree_isdir[k] == true {
        p := tree_path[k]
        if is_expanded(p) {
            kept := []
            for q := 0; q < tree_expanded.len; q++ {
                if tree_expanded[q] != p { kept.push(tree_expanded[q]) }
            }
            tree_expanded = kept
        } else {
            tree_expanded.push(p)
        }
        tree_rebuild()
    } else {
        open_path(tree_path[k])
        tree_focus = false
    }
    dirty = true
}

tree_nav := (f) {
    if tree_name.len == 0 return
    if f == 65 {
        tree_move(0 - 1)
    } else if f == 66 {
        tree_move(1)
    } else if f == 67 {
        if tree_isdir[tree_sel] == false or is_expanded(tree_path[tree_sel]) == false { tree_activate(tree_sel) }
    } else if f == 68 {
        if tree_isdir[tree_sel] == true and is_expanded(tree_path[tree_sel]) { tree_activate(tree_sel) }
    }
}

parse_csi := (s, i) {
    n := _len(s)
    j := i + 2
    while j < n {
        c := i32(rune(s.char_at(j)))
        if c >= 64 and c <= 126 {
            seq_final = c
            seq_params = substring(s, i + 2, j)
            return j - i + 1
        }
        j++
    }
    return 0
}

nav_editor := (f) {
    if f == 65 {
        if cy > 0 { cy--; clamp_cx() }
    } else if f == 66 {
        if cy < lines.len - 1 { cy++; clamp_cx() }
    } else if f == 68 {
        if cx > 0 { cx-- } else if cy > 0 { cy--; cx = lines[cy].len }
    } else if f == 67 {
        if cx < lines[cy].len { cx++ } else if cy < lines.len - 1 { cy++; cx = 0 }
    } else if f == 72 {
        cx = 0
    } else if f == 70 {
        cx = lines[cy].len
    }
}

do_backspace := () {
    if cx > 0 {
        prev_code := i32(rune(lines[cy].char_at(cx - 1)))
        close_code := matching_close(prev_code)
        if close_code != 0 and cx < lines[cy].len() and i32(rune(lines[cy].char_at(cx))) == close_code {
            left := substring(lines[cy], 0, cx - 1)
            right := substring(lines[cy], cx + 1, lines[cy].len())
            lines[cy] = left ~ right
        } else {
            left := substring(lines[cy], 0, cx - 1)
            right := substring(lines[cy], cx, lines[cy].len())
            lines[cy] = left ~ right
        }
        cx--
        modified = true
    } else if cy > 0 {
        prev_len := lines[cy - 1].len()
        lines[cy - 1] = lines[cy - 1] ~ lines[cy]
        lines.take(cy)
        cy--
        cx = prev_len
        modified = true
    }
}

insert_char := (code) {
    left := substring(lines[cy], 0, cx)
    right := substring(lines[cy], cx, lines[cy].len())
    lines[cy] = left ~ string(rune(code)) ~ right
    cx++
    modified = true
}

insert_newline := (indent) {
    ind := 0
    if indent == true {
        while ind < lines[cy].len() and ind < cx and lines[cy].char_at(ind) == " " { ind++ }
    }
    left := substring(lines[cy], 0, cx)
    right := substring(lines[cy], cx, lines[cy].len())
    new_line := repeat_str(" ", ind) ~ right
    lines[cy] = left
    cy++
    lines.add(cy, new_line)
    cx = ind
    modified = true
}

do_delete := () {
    if cx < lines[cy].len() {
        left := substring(lines[cy], 0, cx)
        right := substring(lines[cy], cx + 1, lines[cy].len())
        lines[cy] = left ~ right
        modified = true
    } else if cy < lines.len - 1 {
        lines[cy] = lines[cy] ~ lines[cy + 1]
        lines.take(cy + 1)
        modified = true
    }
}

paste_char := (code) {
    if tree_focus return
    if code == 13 {
        insert_newline(false)
        paste_cr = true
        return
    }
    if code == 10 {
        if paste_cr == false { insert_newline(false) }
        paste_cr = false
        return
    }
    paste_cr = false
    if code == 9 {
        for q := 0; q < 4; q++ { insert_char(32) }
    } else if code >= 32 and code <= 126 {
        insert_char(code)
    } else if code >= 128 {
        insert_char(63)
    }
}

// only really works on wayland may change.

copy_clipboard := () {
    if _len(lines[cy]) == 0 return
    // Send the current line to the clipboard
    sys.feed("wl-copy", lines[cy])
    status_msg = "Copied line to clipboard"
    dirty = true
}

paste_clipboard := () {
    // Use a temp file to avoid the 64KB Vivi string limit because it seems that it will directly crash a program.
    sys.redirect("wl-paste", "/tmp/vivlet_paste.tmp")
    
    if file_exists("/tmp/vivlet_paste.tmp") {
        // Read it safely using file_lines which handles chunking
        pasted_lines := file_lines("/tmp/vivlet_paste.tmp")
        
        if pasted_lines != null and pasted_lines.len() > 0 {
            for i := 0; i < pasted_lines.len(); i++ {
                line_text := pasted_lines[i]
                for c := 0; c < _len(line_text); c++ {
                    insert_char(i32(rune(line_text.char_at(c))))
                }
                // if it's not the last line, press return... enter, potato, potahto.
                if i < pasted_lines.len() - 1 {
                    insert_newline(false)
                }
            }
            status_msg = "Pasted from clipboard"
            dirty = true
        }
        // Cleanup
        _run("rm /tmp/vivlet_paste.tmp")
    }
}

skip_word_left := () {
    if cx == 0 {
        if cy > 0 { cy--; cx = lines[cy].len }
        return
    }
    // Move left while previous chars are spaces
    while cx > 0 and lines[cy].char_at(cx - 1) == " " { cx-- }
    // Move left until we hit a space again
    while cx > 0 and lines[cy].char_at(cx - 1) != " " { cx-- }
}

skip_word_right := () {
    if cx == lines[cy].len {
        if cy < lines.len - 1 { cy++; cx = 0 }
        return
    }
    // Move right while current chars are NOT spaces vim shi
    while cx < lines[cy].len and lines[cy].char_at(cx) != " " { cx++ }
    // Move right while we ARE on spaces
    while cx < lines[cy].len and lines[cy].char_at(cx) == " " { cx++ }
}

page_move := (d) {
    cy += d * VIEW_H
    if cy < 0 cy = 0
    if cy > lines.len - 1 cy = lines.len - 1
    clamp_cx()
}

nav_final := (f) {
    if tree_focus { tree_nav(f) } else { nav_editor(f) }
}

nav_tilde := (p) {
    if tree_focus return
    if p == "1" or p == "7" {
        cx = 0
    } else if p == "4" or p == "8" {
        cx = lines[cy].len
    } else if p == "3" {
        do_delete()
    } else if p == "5" {
        page_move(0 - 1)
    } else if p == "6" {
        page_move(1)
    }
}

prompt_text := (label, initial) {
    typed := initial
    w := TERM_W - 8
    if w > 90 w = 90
    if w < 36 w = 36
    if w > TERM_W - 2 w = TERM_W - 2
    top := (TERM_H / 2) - 1
    if top < 2 top = 2
    left := ((TERM_W - w - 2) / 2) + 1
    if left < 1 left = 1

    while true {
        content := label ~ typed
        if _len(content) > w - 2 {
            content = substring(content, _len(content) - (w - 2), _len(content))
        }
        draw_box(top, left, w, "Input", [content, "Enter: OK  |  Esc: cancel"])
        cursor_to(top + 1, left + 2 + _len(content))
        cursor_show()

        raw := _read(0, 256)
        if raw == null or _len(raw) == 0 continue

        n := _len(raw)
        i := 0
        while i < n {
            code := i32(rune(raw.char_at(i)))
            if code == 27 {
                if n == 1 return null
                if i + 1 < n and raw.char_at(i + 1) == "[" {
                    used := parse_csi(raw, i)
                    if used == 0 { i = n } else { i += used - 1 }
                }
            } else if code == 13 or code == 10 {
                return typed
            } else if code == 127 or code == 8 {
                if _len(typed) > 0 { typed = substring(typed, 0, _len(typed) - 1) }
            } else if code >= 32 and code <= 126 {
                typed ~= string(rune(code))
            }
            i++
        }
    }
}

set_root := (path) {
    ap := sys.abs_dir(path)
    if _len(ap) == 0 {
        status_msg = "Not a folder: " ~ path
        return
    }
    tree_root = ap
    tree_expanded = []
    tree_sel = 0
    tree_scroll = 0
    tree_open = true
    tree_focus = true
    layout()
    tree_rebuild()
    status_msg = "Folder: " ~ ap
}

default_dir := () {
    if _len(tree_root) > 0 return tree_root ~ "/"
    return ""
}

do_open_folder := () {
    p := prompt_text("Open folder: ", default_dir())
    if p != null {
        target := sys.expand_path(p) // Native sys.expand_path
        if _len(target) > 0 { set_root(target) }
    }
    clear_screen()
    dirty = true
}

do_open_file := () {
    p := prompt_text("Open file: ", default_dir())
    if p != null {
        target := sys.expand_path(p)
        if _len(target) > 0 {
            if sys.is_dir(target) {
                set_root(target)
            } else if has_suffix(target, "/") {
                status_msg = "Not a file: " ~ target
            } else {
                open_path(target)
            }
        }
    }
    clear_screen()
    dirty = true
}

tree_click := (row) {
    if row == 0 {
        do_open_folder()
        return
    }
    k := tree_scroll + row - 1
    if k >= 0 and k < tree_name.len {
        tree_sel = k
        tree_focus = true
        tree_activate(k)
    }
}

toggle_tree := () {
    if tree_open == false {
        tree_open = true
        tree_focus = true
        if _len(tree_root) == 0 { tree_root = sys.abs_dir(".") }
        tree_rebuild()
    } else if tree_focus == false {
        tree_focus = true
    } else {
        tree_open = false
        tree_focus = false
    }
    layout()
    clear_screen()
    dirty = true
}

menu_popup := () {
    w := 34
    top := (TERM_H / 2) - 3
    if top < 2 top = 2
    left := ((TERM_W - w - 2) / 2) + 1
    if left < 1 left = 1
    items := ["[N] New empty tab", "[O] Open a file...", "[D] Open a folder (tree)", "", "Esc: cancel"]
    while true {
        draw_box(top, left, w, "New / Open", items)
        raw := _read(0, 64)
        if raw == null or _len(raw) == 0 continue
        code := i32(rune(raw.char_at(0)))
        if code == 27 {
            if _len(raw) == 1 return 0
            if raw.char_at(1) == "[" {
                used := parse_csi(raw, 0)
                if used > 0 and seq_final == 77 and has_prefix(seq_params, "<0;") {
                    parts := split(substring(seq_params, 1, _len(seq_params)), ";")
                    if parts.len >= 3 {
                        row := i32(parts[2]) - top - 1
                        if row == 0 return 1
                        if row == 1 return 2
                        if row == 2 return 3
                    }
                }
            }
            continue
        }
        if code == 110 or code == 78 or code == 49 return 1
        if code == 111 or code == 79 or code == 102 or code == 70 or code == 50 return 2
        if code == 100 or code == 68 or code == 51 return 3
    }
}

do_menu := () {
    choice := menu_popup()
    if choice == 1 {
        add_tab("", new_rows())
        status_msg = "New empty tab"
    } else if choice == 2 {
        do_open_file()
    } else if choice == 3 {
        do_open_folder()
    }
    clear_screen()
    dirty = true
}

do_settings := () {
    w := 34
    top := (TERM_H / 2) - 3
    if top < 2 top = 2
    left := ((TERM_W - w - 2) / 2) + 1
    if left < 1 left = 1

    while true {
        vim_status := if vim_mode { "[X] Vim Keybindings" } else { "[ ] Vim Keybindings" }
        items := ["Settings", "", vim_status, "", "Esc: back"]

        draw_box(top, left, w, "Settings", items)
        raw := _read(0, 64)
        if raw == null or _len(raw) == 0 continue
        code := i32(rune(raw.char_at(0)))

        if code == 27 return // Esc

        // Toggle Vim mode if they press V or Enter on the line
        if code == 118 or code == 86 or code == 13 {
            vim_mode = !vim_mode
            vim_insert = true
            status_msg = if vim_mode { "Vim mode ON" } else { "Vim mode OFF" }
            dirty = true
        }
    }
}

do_save := () {
    if _len(current_file) > 0 {
        save_to_disk(current_file)
    } else {
        p := prompt_text("Save file to what location: ", default_dir())
        if p == null {
            status_msg = "Save cancelled"
        } else {
            target := sys.expand_path(p)
            if _len(target) == 0 or has_suffix(target, "/") {
                status_msg = "Save cancelled (no file name)"
            } else {
                save_to_disk(target)
            }
        }
        clear_screen()
    }
    dirty = true
}

do_quit := () {
    save_tab()
    count := 0
    for q := 0; q < tab_mod.len; q++ {
        if tab_mod[q] == true { count++ }
    }
    if count > 0 {
        if confirm("Unsaved changes in " ~ string(count) ~ " tab(s). Quit anyway?") == true { running = false }
        clear_screen()
        dirty = true
    } else {
        running = false
    }
}

tab_click := (mx) {
    if mx <= 3 { do_menu(); return }
    for q := 0; q < hit_tab.len; q++ {
        if mx >= hit_x0[q] and mx <= hit_x1[q] {
            if mx >= hit_x1[q] - 2 { close_tab(hit_tab[q]) } else { switch_tab(hit_tab[q]) }
            return
        }
    }
}

handle_mouse := (b, mx, my, press) {
    if b >= 64 and b < 128 {
        if tree_open and mx <= TW {
            if b % 2 == 0 { tree_scroll -= 3 } else { tree_scroll += 3 }
            mx_scroll := tree_name.len - (VIEW_H - 1)
            if tree_scroll > mx_scroll tree_scroll = mx_scroll
            if tree_scroll < 0 tree_scroll = 0
        } else {
            if b % 2 == 0 { cy -= 3 } else { cy += 3 }
            if cy < 0 cy = 0
            if cy > lines.len - 1 cy = lines.len - 1
            clamp_cx()
        }
        return
    }
    if press == false return
    if b >= 32 or b % 4 != 0 return

    if my == 1 {
        tab_click(mx)
    } else if my >= 2 and my <= VIEW_H + 1 {
        if tree_open and mx <= TW {
            tree_click(my - 2)
        } else if tree_open == false or mx > TW + 1 {
            tree_focus = false
            ny := (my - 2) + scroll_y
            if ny > lines.len - 1 ny = lines.len - 1
            if ny < 0 ny = 0
            cy = ny
            nx := (mx - ED_X) + scroll_x
            if nx < 0 nx = 0
            if nx > lines[cy].len nx = lines[cy].len
            cx = nx
        }
    }
}

handle_esc_key := () {
    if vim_mode and vim_insert {
        vim_insert = false
        status_msg = "NORMAL"
        if cx > 0 and _len(lines[cy]) > 0 { cx-- }
    } else if vim_mode and !vim_insert {
        vim_pending_count = ""
        vim_operator = ""
        vim_visual = false
        status_msg = "NORMAL"
    } else if tree_focus {
        tree_focus = false
    }
    dirty = true
}

handle_csi := () {
    f := seq_final
    p := seq_params

    if in_paste {
        if f == 126 and p == "201" { in_paste = false }
        return
    }
    if f == 126 and p == "200" {
        in_paste = true
        paste_cr = false
        tree_focus = false
        return
    }
    if has_prefix(p, "<") {
        parts := split(substring(p, 1, _len(p)), ";")
        if parts.len >= 3 {
            handle_mouse(i32(parts[0]), i32(parts[1]), i32(parts[2]), f == 77)
        }
        return
    }

    // Ctrl + Left/Right for word skipping (usually ESC [ 1 ; 5 D / C)
    if p == "1;5" {
        if f == 68 {
            if tree_focus { tree_nav(68) } else { skip_word_left() }
            return
        }
        if f == 67 {
            if tree_focus { tree_nav(67) } else { skip_word_right() }
            return
        }
    }

    // Ctrl + Backspace (usually ESC [ 127 ; 5 u or just handled by OS as a different sequence "works on my machine")
    // Standard Home/End/Arrows
    if f == 126 { nav_tilde(p) } else { nav_final(f) }
}

// cl(i maybe?) for said handle_vim_normal function.
vim_command_line := () {
    cmd := prompt_text(":", "")
    if cmd == null return
    if cmd == "w" or cmd == "w!" {
        do_save()
    } else if cmd == "q" or cmd == "q!" {
        do_quit()
    } else if cmd == "wq" or cmd == "x" {
        do_save()
        do_quit()
    } else if has_prefix(cmd, "e ") {
        open_path(substring(cmd, 2, _len(cmd)))
    }
    dirty = true
}

//massive engine so that vim can be used and feel nicer than just keybind stuff.
handle_vim_normal := (code) {
    c := string(rune(code))
    
    // Handle numbers for counts (1-9, then 0)
    if code >= 49 and code <= 57 {
        vim_pending_count ~= c
        status_msg = vim_pending_count
        return
    }
    if code == 48 and _len(vim_pending_count) > 0 {
        vim_pending_count ~= "0"
        return
    }

    // Parse the count (default to 1)
    count := 1
    if _len(vim_pending_count) > 0 {
        count = i32(vim_pending_count)
        vim_pending_count = ""
    }

    // VISUAL MODE
    if vim_visual {
        if code == 27 { // Esc -> exit visual
            vim_visual = false
            status_msg = "NORMAL"
        } else if code == 100 { // 'd' -> delete selection (line for now)
            vim_visual = false
            lines[cy] = ""
            cx = 0
            modified = true
        } else if code == 121 { // 'y' -> yank selection
            vim_visual = false
            vim_register = lines[cy]
            status_msg = "Yanked line"
        } 
        // Movement in visual mode
        else if code == 104 { nav_editor(68) } 
        else if code == 108 { nav_editor(67) } 
        else if code == 106 { nav_editor(66) } 
        else if code == 107 { nav_editor(65) }
        return
    }

    // OPERATORS (d, y, c) whatever they need
    if vim_operator != "" {
        op := vim_operator
        vim_operator = ""
        
        if op == "d" {
            if code == 100 { // 'dd' -> delete line
                for i := 0; i < count; i++ {
                    lines.take(cy)
                    if lines.len() == 0 { lines.push("") }
                    if cy >= lines.len() { cy = lines.len() - 1 }
                }
                cx = 0
                modified = true
            } else if code == 119 { // 'dw' -> delete word
                // Simple word delete (spaces and text)
                for i := 0; i < count; i++ { skip_word_right() }
                lines[cy] = substring(lines[cy], 0, cx) // crude, but works for now
                modified = true
            }
        } else if op == "y" {
            if code == 121 { // 'yy' -> yank line
                vim_register = lines[cy]
                status_msg = "Yanked " ~ string(count) ~ " line(s)"
            }
        } else if op == "c" {
            if code == 99 { // 'cc' -> change line
                lines[cy] = ""
                cx = 0
                vim_insert = true
                modified = true
            }
        }
        return
    }

    // NORMAL MODE
    if code == 105 { // 'i' -> Insert
        vim_insert = true
        status_msg = "-- INSERT --"
    } else if code == 97 { // 'a' -> Append
        if cx < lines[cy].len { cx++ }
        vim_insert = true
        status_msg = "-- INSERT --"
    } else if code == 65 { // 'A' -> Append End
        cx = lines[cy].len
        vim_insert = true
        status_msg = "-- INSERT --"
    } else if code == 73 { // 'I' -> Insert Start
        cx = 0
        vim_insert = true
        status_msg = "-- INSERT --"
    } else if code == 111 { // 'o' -> Open below
        nav_editor(66) 
        insert_newline(false)
        vim_insert = true
    } else if code == 79 { // 'O' -> Open above
        insert_newline(false)
        nav_editor(65) 
        vim_insert = true
    } 
    // Navigation
    else if code == 104 { // 'h'
        for i := 0; i < count; i++ { nav_editor(68) }
    } else if code == 106 { // 'j'
        for i := 0; i < count; i++ { nav_editor(66) }
    } else if code == 107 { // 'k'
        for i := 0; i < count; i++ { nav_editor(65) }
    } else if code == 108 { // 'l'
        for i := 0; i < count; i++ { nav_editor(67) }
    } else if code == 119 { // 'w'
        for i := 0; i < count; i++ { skip_word_right() }
    } else if code == 98 { // 'b'
        for i := 0; i < count; i++ { skip_word_left() }
    } else if code == 48 { // '0'
        cx = 0 
    } else if code == 36 { // '$'
        cx = lines[cy].len 
    } else if code == 71 { // 'G'
        cy = lines.len - 1
        cx = 0
    }
    // Editing
    else if code == 120 { // 'x'
        for i := 0; i < count; i++ { do_delete() }
    } else if code == 112 { // 'p'
        if _len(vim_register) > 0 {
            insert_newline(false)
            for i := 0; i < _len(vim_register); i++ {
                insert_char(i32(rune(vim_register.char_at(i))))
            }
            status_msg = "Pasted"
        }
    }
    // Operators
    else if code == 100 { vim_operator = "d" } // 'd'
    else if code == 121 { vim_operator = "y" } // 'y'
    else if code == 99 { vim_operator = "c" }  // 'c'
    // Visual
    else if code == 118 { vim_visual = true; status_msg = "-- VISUAL --" } // 'v'
    // Command line
    else if code == 58 { // ':'
        vim_command_line()
    }
    
    dirty = true
}

process_input := () {
    n := _len(buf)
    idx := 0
    single := n == 1

    while idx < n {
        code := i32(rune(buf.char_at(idx)))

        if code == 27 {
            if idx + 1 >= n { break }
            nxt := buf.char_at(idx + 1)
            if nxt == "[" {
                used := parse_csi(buf, idx)
                if used == 0 { break }
                handle_csi()
                idx += used
            } else if nxt == "O" {
                if idx + 2 >= n { break }
                if in_paste == false { nav_final(i32(rune(buf.char_at(idx + 2)))) }
                idx += 3
            } else {
                if in_paste == false { handle_esc_key() }
                idx++
            }
            continue
        }

        if in_paste {
            paste_char(code)
            idx++
            continue
        }

        // Vim flop "Normal" Mode intercept, whatever you wanna call it :3
        if vim_mode and !vim_insert {
            handle_vim_normal(code)
            idx++
            continue
        }

        if code == 17 {
            do_quit()
            if running == false return
        } else if code == 11 {
            do_settings()
        } else if code == 3 {
            copy_clipboard()
        } else if code == 22 {
            paste_clipboard()
        } else if code == 19 {
            do_save()
        } else if code == 20 {
            do_menu()
        } else if code == 15 {
            do_open_file()
        } else if code == 2 {
            toggle_tree()
        } else if code == 23 {
            close_tab(cur_tab)
        } else if code == 14 {
            next_tab(1)
        } else if code == 16 {
            next_tab(0 - 1)
        } else if tree_focus {
            if code == 13 or code == 10 { tree_activate(tree_sel) }
        } else if code == 13 or code == 10 {
            insert_newline(true)
        } else if code == 127 or code == 8 {
            do_backspace()
        } else if code >= 32 and code <= 126 { // printable ASCII, autoclose pairs
            close_code := matching_close(code)

            // Use char_at() instead of [] to avoid the Vivi string indexing bug!
            is_skipping := false
            if single and is_closing_char(code) and cx < lines[cy].len {
                if i32(rune(lines[cy].char_at(cx))) == code {
                    is_skipping = true
                }
            }

            if is_skipping {
                cx++
            } else if single and close_code != 0 {
                insert_char(code)
                insert_char(close_code)
                cx-- // Move cursor back inside the brackets
                modified = true
            } else {
                insert_char(code)
            }
        }
        idx++
    }

    if idx < n { buf = substring(buf, idx, n) } else { buf = "" }
    dirty = true
}

tree_row := (r) {
    text := ""
    style := 0
    if r == 0 {
        text = " " ~ base_name(tree_root) ~ "/"
        style = 2
    } else {
        k := tree_scroll + r - 1
        if k < tree_name.len {
            marker := "  "
            if tree_isdir[k] == true {
                if is_expanded(tree_path[k]) { marker = "v " } else { marker = "> " }
            }
            text = " " ~ repeat_str("  ", tree_depth[k]) ~ marker ~ tree_name[k]
            if k == tree_sel style = 1
        }
    }
    if _len(text) > TW text = substring(text, 0, TW)
    text ~= repeat_str(" ", TW - _len(text))
    if style == 2 return bold(text) ~ "│"
    if style == 1 {
        if tree_focus return inverse(text) ~ "│"
        return bold(text) ~ "│"
    }
    return text ~ "│"
}

render := () {
    if cy > lines.len() - 1 cy = lines.len() - 1
    if cy < 0 cy = 0
    if cy < scroll_y scroll_y = cy
    if cy >= scroll_y + VIEW_H scroll_y = cy - VIEW_H + 1
    if cx < scroll_x scroll_x = cx
    if cx >= scroll_x + VIEW_W scroll_x = cx - VIEW_W + 1

    _write(1, CSI ~ "?25l")
    avail := TERM_W - 1
    labels := []
    for q := 0; q < tab_paths.len(); q++ {
        nm := base_name(tab_paths[q])
        isd := tab_mod[q]
        if q == cur_tab {
            nm = base_name(current_file)
            isd = modified
        }
        if nm.len() == 0 nm = "untitled"
        if isd == true { nm ~= "*" }
        if nm.len() > 18 nm = substring(nm, 0, 18)
        labels.push(" " ~ nm ~ " x ")
    }
    if tab_first > cur_tab tab_first = cur_tab
    while tab_first < cur_tab {
        total := 0
        for q := tab_first; q <= cur_tab; q++ { total += labels[q].len() }
        if total <= avail - 4 { break }
        tab_first++
    }
    bar := bold(" + ") ~ " "
    used := 4
    hit_tab = []
    hit_x0 = []
    hit_x1 = []
    for q := tab_first; q < labels.len(); q++ {
        w := labels[q].len()
        if used + w > avail { break }
        if q == cur_tab { bar ~= inverse(labels[q]) } else { bar ~= dim(labels[q]) }
        hit_tab.push(q)
        hit_x0.push(used + 1)
        hit_x1.push(used + w)
        used += w
    }
    bar ~= repeat_str(" ", avail - used)
    _write(1, CSI ~ "1;1H" ~ bar)

    is_empty := lines.len() == 1 and lines[0].len() == 0 and current_file.len() == 0
    title := "Vivlet 1.1.7"
    subtitle := "Created by Xansidev - github:XansiOnGit"
    hint := "Ctrl+T: new / open     Ctrl+B: file tree"
    mid_row := VIEW_H / 2
    mid_col := (VIEW_W - title.len()) / 2
    sub_col := (VIEW_W - subtitle.len()) / 2
    hint_col := (VIEW_W - hint.len()) / 2

    for r := 0; r < VIEW_H; r++ {
        row_frame := CSI ~ "{r + 2};1H"
        if tree_open { row_frame ~= tree_row(r) }
        file_r := r + scroll_y
        printed := 0

        if is_empty and r == mid_row and mid_col >= 0 {
            row_frame ~= repeat_str(" ", mid_col) ~ dim(title)
            printed = mid_col + title.len()
        } else if is_empty and r == mid_row + 1 and sub_col >= 0 {
            row_frame ~= repeat_str(" ", sub_col) ~ dim(subtitle)
            printed = sub_col + subtitle.len()
        } else if is_empty and r == mid_row + 3 and hint_col >= 0 {
            row_frame ~= repeat_str(" ", hint_col) ~ dim(hint)
            printed = hint_col + hint.len()
        } else if file_r < lines.len() {
            row_str := lines[file_r]
            if scroll_x < row_str.len() {
                end := scroll_x + VIEW_W
                if end > row_str.len() end = row_str.len()
                row_frame ~= substring(row_str, scroll_x, end)
                printed = end - scroll_x
            }
        }
        row_frame ~= repeat_str(" ", VIEW_W - printed)
        _write(1, row_frame)
    }

    hints := "^S Save  ^T New/Open  ^B Tree  ^W Close  ^N/^P Tabs  ^Q Quit"
    mode_str := "INS "
    
    if vim_mode {
        if vim_visual {
            mode_str = "-- VISUAL -- "
        } else if vim_insert {
            mode_str = "-- INSERT -- "
        } else {
            mode_str = "-- NORMAL -- "
        }
        if _len(vim_pending_count) > 0 { mode_str = mode_str ~ vim_pending_count }
        if _len(vim_operator) > 0 { mode_str = mode_str ~ vim_operator }
    }
    foot := " " ~ mode_str ~ hints
    if status_msg.len() > 0 { foot = " " ~ mode_str ~ status_msg ~ "  |  " ~ hints }
    if status_msg.len() > 0 { foot = " " ~ status_msg ~ "  |  " ~ hints }
    pos := "Ln {cy + 1}, Col {cx + 1} "
    room := TERM_W - 1 - pos.len()
    if foot.len() > room foot = substring(foot, 0, room)
    foot ~= repeat_str(" ", room - foot.len())
    _write(1, CSI ~ "{TERM_H};1H" ~ dim(foot ~ pos))

    if tree_focus {
        _write(1, CSI ~ "?25l")
    } else {
        screen_y := (cy - scroll_y) + 2
        screen_x := (cx - scroll_x) + ED_X
        _write(1, CSI ~ "{screen_y};{screen_x}H" ~ CSI ~ "?25h")
    }
    dirty = false
}

init_tabs := () {
    tab_lines.push(new_rows())
    tab_cx.push(0)
    tab_cy.push(0)
    tab_sx.push(0)
    tab_sy.push(0)
    tab_paths.push("")
    tab_mod.push(false)
    cur_tab = 0
}

init_from_args := () {
    tree_root = sys.abs_dir(".")

    raw_cmd := file_read("/proc/self/cmdline")
    if raw_cmd == null return

    cli_args := []
    cur := ""
    for i := 0; i < _len(raw_cmd); i++ {
        ch := raw_cmd.char_at(i)
        if i32(rune(ch)) == 0 {
            if _len(cur) > 0 cli_args.push(cur)
            cur = ""
        } else {
            cur ~= ch
        }
    }

    if cli_args.len >= 3 {
        target := sys.expand_path(cli_args[2])
        if sys.is_dir(target) { set_root(target) } else { open_path(target) }
    }
}

run_editor := () {
    while running {
        data := _read(0, 4096)
        if data == null or _len(data) == 0 {
            if _len(buf) == 1 {
                buf = ""
                handle_esc_key()
                dirty = true
            } else {
                buf = ""
            }

            frame_count++
            if frame_count >= 20 {
                frame_count = 0
                if sys.sigwinch_poll() {
                    sz := sys.term_size()
                    TERM_W = sz[0]
                    TERM_H = sz[1]
                    layout()
                    clear_screen()
                    dirty = true
                }
            }
            if dirty render()
            continue
        }

        buf ~= data
        process_input()
        if running and dirty { render() }
    }
}

init_tabs()
init_from_args()

// Native termios raw mode FINALLY NO LAG :DDDDDD!!
sys.tty_raw()
sys.sigwinch_init() // Setup native signal handling

// alt screen, mouse, bracketed paste
print(CSI ~ "?1049h" ~ CSI ~ "?1000h" ~ CSI ~ "?1006h" ~ CSI ~ "?2004h")

// Initial size fetch
sz := sys.term_size()
TERM_W = sz[0]
TERM_H = sz[1]
layout()
clear_screen()
render()

crash_msg := ""
try {
    run_editor()
} catch (err) {
    crash_msg = string(err)
}

// Restore everything cleanly
print(CSI ~ "?2004l" ~ CSI ~ "?1006l" ~ CSI ~ "?1000l" ~ CSI ~ "?1049l" ~ CSI ~ "?25h")
sys.sigwinch_close()
sys.tty_restore()

if _len(crash_msg) > 0 {
    println("vivlet crashed: " ~ crash_msg)
}

// wow thanks for reading through my actually spaghetti code :3 -Xansidev
